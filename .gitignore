# Database files (regenerated on first run)
*.db
*.sqlite
*.sqlite3

# Environment lockfiles (large; regenerate with `pip freeze`)
environment.lock
requirements-lock.txt

# Logs
logs/*.log
logs/*.json

# Jupyter notebooks outputs
.ipynb_checkpoints/

# Test artifacts
.coverage
htmlcov/
.pytest_cache/
.tox/
mypy_cache/

# Temporary files
*.tmp
*.temp
*.bak
*.orig
